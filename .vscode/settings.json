{
  // Extension Pack for Java：F5 调试时默认 dev profile
  "java.debug.settings.vmArgs": "-Dspring.profiles.active=dev",
  "java.configuration.updateBuildConfiguration": "automatic",
  // uni-app 配置文件支持注释（JSON with Comments）
  "files.associations": {
    "pages.json": "jsonc",
    "manifest.json": "jsonc"
  }
}
