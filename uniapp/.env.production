# 生产构建（npm run build:h5 / build:mp-weixin）专用，会覆盖 .env 里的开发地址
# H5 部署 app.wushij.com：同域 Nginx 反代 /api
VITE_API_BASE_URL=/api
# 小程序无法使用相对路径，build:mp-weixin 时由 api-base 拼成完整 HTTPS 地址
VITE_API_PRODUCTION_ORIGIN=https://app.wushij.com
VITE_APP_TITLE=Wu-Admin
VITE_APP_VERSION=1.0.0
VITE_APP_ENV=production
