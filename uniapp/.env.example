# 复制为 .env 后用于本地开发；生产打包自动读 .env.production
#
# 本地开发（.env）：
# VITE_API_BASE_URL=http://127.0.0.1:8080/api
# 小程序真机：改为 http://你的电脑局域网IP:8080/api
#
# 生产 H5（.env.production，npm run build:h5）：
# VITE_API_BASE_URL=/api
# VITE_API_PRODUCTION_ORIGIN=https://app.wushij.online
#
# 生产小程序（同上 build:mp-weixin，api-base 会自动拼完整 HTTPS 地址）
VITE_API_BASE_URL=http://127.0.0.1:8080/api
VITE_APP_TITLE=Wu-Admin
VITE_APP_VERSION=1.0.0
VITE_APP_ENV=development
